{
  "manifest_version": 3,
  "name": "LinkedIn HR Outreach",
  "description": "Review job-post leads from LinkedIn in a private side panel.",
  "version": "0.1.0",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/*", "https://mail.google.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "index.html" },
  "content_scripts": [{ "matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_title": "Open LinkedIn HR Outreach" }
}
